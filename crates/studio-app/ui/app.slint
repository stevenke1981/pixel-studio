// Pixel Studio — Slint front-end. All document logic lives in Rust (doc.rs);
// this file only lays out widgets and forwards input.
import { Button, CheckBox, ComboBox, LineEdit, Slider, SpinBox, ScrollView, TextEdit, ListView } from "std-widgets.slint";

export global T {
    in property <bool> zh: true;
    public pure function t(zh-text: string, en-text: string) -> string {
        return zh ? zh-text : en-text;
    }
}

export struct LayerRow { name: string, kind: int, visible: bool, selected: bool }
export struct StickerItem { id: string, img: image }
export struct BoxItem { x: float, y: float, w: float, h: float, selected: bool, label: string }
export struct ToolItem { zh: string, en: string, group: int }
export struct MItem { label: string, key: string, act: string, enabled: bool, sep: bool, checked: bool, check: bool, icon: image }
export struct Tick { pos: length, label: string, major: bool }
export struct MTitle { zh: string, en-rest: string, key: string }

// Shared hover tooltip, drawn once on top of the whole window.
export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
}

component Section inherits Text {
    font-weight: 700;
    font-size: 13px;
    color: #1f3b63;
}

component Swatch inherits Rectangle {
    in property <color> c;
    callback pick(bool);
    width: 20px;
    height: 20px;
    border-radius: 3px;
    border-width: 1px;
    border-color: #8888;
    background: c;
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.pick(e.button == PointerEventButton.right);
            }
        }
    }
}

// Icon-only button: tooltip (label + shortcut) on hover, clear hover/pressed/
// disabled/active states, exposed to screen readers as a button with that label.
component IBtn inherits Rectangle {
    in property <image> icon;
    in property <string> tip;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <length> size: 30px;
    in property <length> icon-size: 18px;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: 5px;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    background: root.active ? (ta.has-hover ? #255fd6 : #2f6fed) : !root.enabled ? transparent : ta.pressed ? #c2d2f3 : ta.has-hover ? #e4ecfb : transparent;
    border-width: ta.has-hover && root.enabled && !root.active ? 1px : 0px;
    border-color: #c3d2ee;
    Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (ta.pressed && root.enabled ? 1px : 0px);
        colorize: root.active ? #ffffff : root.enabled ? #1d2a3a : #b3bac4;
    }
    ta := TouchArea { clicked => { if (root.enabled) { root.clicked(); } } }
    // Show the shared tooltip after a short hover delay; hide it on leave.
    Timer {
        interval: 450ms;
        running: ta.has-hover && root.tip != "" && Tip.text != root.tip;
        triggered => {
            Tip.text = root.tip;
            Tip.x = root.absolute-position.x;
            Tip.y = root.absolute-position.y + root.height + 4px;
        }
    }
    property <bool> hov: ta.has-hover;
    changed hov => { if (!self.hov && Tip.text == root.tip) { Tip.text = ""; } }
}

component MenuRow inherits Rectangle {
    in property <string> label;
    in property <string> shortcut;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> check: false;
    in property <bool> checked: false;
    in property <bool> highlighted: false;
    callback clicked();
    callback hovered();
    height: 26px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    background: (ma.has-hover || root.highlighted) && root.enabled ? #e3ebfb : transparent;
    HorizontalLayout {
        padding-left: 8px; padding-right: 12px;
        spacing: 8px;
        Rectangle {
            width: 18px;
            if root.check && root.checked: Image { source: @image-url("icons/check.svg"); width: 15px; height: 15px; colorize: #1d2a3a; }
            if !root.check: Image { source: root.icon; width: 16px; height: 16px; colorize: root.enabled ? #33475b : #b4bac3; }
        }
        Text { text: root.label; vertical-alignment: center; color: root.enabled ? #1d2a3a : #b4bac3; horizontal-stretch: 1; }
        Text { text: root.shortcut; vertical-alignment: center; color: root.enabled ? #6b7785 : #c3c8ce; font-size: 11px; }
    }
    ma := TouchArea {
        clicked => { if (root.enabled) { root.clicked(); } }
        changed has-hover => { if (self.has-hover) { root.hovered(); } }
    }
}

// Modal dialog shell: dims the window, centred card with a title and a close icon.
component Dialog inherits Rectangle {
    in property <string> title;
    in property <length> card-width: 420px;
    callback close();
    background: #0006;
    TouchArea { }
    Rectangle {
        width: min(root.card-width, root.width - 40px);
        height: min(dl.preferred-height, root.height - 40px);
        background: white;
        border-radius: 8px;
        drop-shadow-blur: 16px;
        drop-shadow-color: #0006;
        dl := VerticalLayout {
            padding: 16px;
            spacing: 10px;
            HorizontalLayout {
                Text { text: root.title; font-size: 16px; font-weight: 700; color: #1f3b63; horizontal-stretch: 1; vertical-alignment: center; }
                IBtn { icon: @image-url("icons/close.svg"); size: 28px; tip: T.t("關閉 (Esc)", "Close (Esc)"); clicked => { root.close(); } }
            }
            @children
        }
    }
}

component KeyRow inherits HorizontalLayout {
    in property <string> keys;
    in property <string> what;
    spacing: 12px;
    Text { text: root.keys; width: 150px; color: #2f6fed; font-weight: 600; }
    Text { text: root.what; horizontal-stretch: 1; wrap: word-wrap; }
}

component LabeledSlider inherits HorizontalLayout {
    in property <string> label;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <int> decimals: 0;
    callback apply();
    in property <bool> has-apply: true;
    spacing: 6px;
    Text { text: label; width: 78px; vertical-alignment: center; overflow: elide; }
    Slider { minimum: root.minimum; maximum: root.maximum; value <=> root.value; }
    Text { width: 40px; vertical-alignment: center; text: root.decimals == 0 ? round(root.value) : round(root.value * 10) / 10; }
    if has-apply: IBtn { icon: @image-url("icons/apply.svg"); size: 28px; tip: T.t("套用", "Apply ") + root.label; clicked => { root.apply(); } }
}

export component AppWindow inherits Window {
    title: "Pixel Studio 像素工作室";
    preferred-width: 1400px;
    preferred-height: 860px;
    min-width: 900px;
    min-height: 600px;
    background: #eef1f5;
    icon: @image-url("../assets/icon-256.png");
    default-font-family: root.ui-font;

    // ---------------------------------------------------------------- state
    in property <image> canvas;
    in property <int> img-w: 1;
    in property <int> img-h: 1;
    in-out property <float> zoom: 1.0;
    in-out property <length> pan-x: 0px;
    in-out property <length> pan-y: 0px;
    in property <bool> pixelated: false;
    in property <string> grid-path: "";
    in property <bool> show-grid-overlay: false;
    in property <bool> has-selection;
    in property <float> sel-x; in property <float> sel-y; in property <float> sel-w; in property <float> sel-h;
    in property <bool> sel-circle;
    in property <bool> has-preview;
    in property <float> pv-x; in property <float> pv-y; in property <float> pv-w; in property <float> pv-h;
    in property <bool> has-layer-box;
    in property <float> lb-x; in property <float> lb-y; in property <float> lb-w; in property <float> lb-h;
    in property <bool> lb-handle;
    in property <[BoxItem]> boxes;
    in property <bool> show-boxes;
    out property <length> canvas-w: canvas-area.width;
    out property <length> canvas-h: canvas-area.height;

    in property <string> status;
    in property <string> cursor-info;
    in property <string> doc-info;
    in property <string> title-file;
    in property <bool> view-mode;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> dirty-doc;

    in-out property <int> tool: 2;
    in property <[ToolItem]> tools;
    in-out property <color> color1: #000000;
    in-out property <color> color2: #ffffff;
    in property <[color]> palette;
    in-out property <float> stroke-width: 4;
    in-out property <int> shape-kind: 2;
    in-out property <bool> shape-filled;
    in-out property <float> fill-tolerance: 16;
    in-out property <bool> show-grid: true;
    in-out property <bool> keep-metadata;
    in-out property <int> tab: 0;
    in-out property <int> language: 0;

    // export
    in-out property <int> export-format: 0;
    in property <[string]> format-names;
    in-out property <float> quality: 90;
    in-out property <bool> webp-lossless: true;

    // canvas presets / text styles
    in property <[string]> preset-names;
    in-out property <int> new-w: 1080;
    in-out property <int> new-h: 1080;
    in-out property <string> style-text: "標題文字";

    // layers
    in property <[LayerRow]> layers;
    in property <int> sel-kind: -1; // -1 none, 0 text, 1 image, 2 shape, 3 sticker
    in-out property <string> l-name;
    in-out property <string> l-text;
    in-out property <float> l-font-size: 48;
    in-out property <float> l-opacity: 100;
    in-out property <bool> l-stroke;
    in-out property <bool> l-shadow;
    in-out property <int> l-w; in-out property <int> l-h;
    in-out property <float> l-stroke-width: 4;
    in-out property <bool> l-filled;
    in property <[string]> font-names;
    in-out property <int> l-font: 0;

    // adjust
    in-out property <int> rs-w; in-out property <int> rs-h;
    in-out property <bool> rs-keep: true;
    in-out property <bool> select-circle;
    in-out property <float> a-bright: 20; in-out property <float> a-contrast: 20; in-out property <float> a-sat: 20;
    in-out property <float> a-expo: 0.5; in-out property <float> a-blur: 2; in-out property <float> a-sharp: 1.5;
    in-out property <float> a-hue: 30; in-out property <float> a-sepia: 0.8; in-out property <float> a-vig: 0.5;
    in-out property <float> a-temp: 20; in-out property <float> a-tint: 20; in-out property <float> a-post: 4;

    // stickers
    in property <[StickerItem]> stickers;
    in-out property <string> sticker-query;
    in property <[string]> sticker-categories;
    in-out property <int> sticker-category: 0;
    in-out property <float> st-stroke: 4;
    in-out property <bool> st-shadow: true;
    in-out property <color> st-fill: #e53935;
    in-out property <color> st-outline: #ffffff;
    out property <bool> dragging-sticker: false;
    property <image> drag-img;
    property <string> drag-id;
    property <length> drag-x; property <length> drag-y;

    // redact
    in property <string> redact-info;
    in property <bool> detecting;
    in-out property <int> redact-style: 0;
    in-out property <float> redact-padding: 4;
    in-out property <float> mosaic-block: 12;
    in-out property <float> blur-sigma: 10;
    in-out property <string> redact-keyword;
    in-out property <float> redact-radius: 12;
    in property <[BoxItem]> box-list;

    // info / c2pa
    in property <string> info-text;
    in property <string> c2pa-text;
    in-out property <string> c2pa-title; in-out property <string> c2pa-creator; in-out property <string> c2pa-action: "c2pa.edited";
    in-out property <bool> c2pa-on-save;

    // batch
    in-out property <string> batch-in; in-out property <string> batch-out;
    in-out property <int> batch-format: 0;
    in-out property <int> batch-max-w: 0; in-out property <int> batch-max-h: 0;
    in-out property <string> batch-watermark;
    in property <string> batch-progress;
    in property <bool> batch-running;
    in-out property <float> gif-delay: 500;
    in-out property <bool> gif-repeat: true;
    in-out property <int> gif-max: 0;
    in property <string> gif-frames;
    in-out property <int> pano-mode: 0;
    in-out property <int> pano-width: 0;

    // settings
    in property <string> shell-state;
    in property <string> version;

    // quick toolbar / context menu / dialogs
    in-out property <int> tb-mode: 0; // 0 floating, 1 docked, 2 hidden
    in-out property <length> tb-x: 12px;
    in-out property <length> tb-y: 12px;
    in property <bool> grid-on;
    in-out property <bool> ctx-open;
    in-out property <length> ctx-x;
    in-out property <length> ctx-y;
    in property <bool> has-layer;
    in-out property <bool> qs-open;
    in property <string> qs-target;
    in-out property <bool> c2pa-open;
    in property <bool> c2pa-present;
    in property <string> c2pa-raw;
    in property <bool> has-source;
    in-out property <string> c2pa-in; in-out property <string> c2pa-out;
    in property <string> c2pa-batch-text;
    in property <bool> show-edge-handles;
    // menu bar / view toggles / extra dialogs
    in property <string> ui-font;
    in-out property <int> menu-open: -1;
    in-out property <int> menu-hl: -1;
    in-out property <bool> recent-open;
    in property <[string]> recent-files;
    in-out property <bool> show-status: true;
    in-out property <bool> show-rulers: false;
    in property <bool> full-screen-on;
    in property <[Tick]> ruler-x;
    in property <[Tick]> ruler-y;
    in-out property <bool> rs-open;
    in-out property <bool> props-open;
    in property <string> props-text;
    in-out property <bool> about-open;
    in-out property <bool> keys-open;
    property <[string]> tool-keys: ["S", "P", "B", "L", "A", "K", "E", "F", "I", "T", "M", "C", "H", "U", "R", "Shift+R"];
    property <[image]> tool-icons: [@image-url("icons/tool-select.svg"), @image-url("icons/tool-pencil.svg"), @image-url("icons/tool-brush.svg"), @image-url("icons/tool-highlighter.svg"), @image-url("icons/tool-airbrush.svg"), @image-url("icons/tool-calligraphy.svg"), @image-url("icons/tool-eraser.svg"), @image-url("icons/tool-fill.svg"), @image-url("icons/tool-picker.svg"), @image-url("icons/tool-text.svg"), @image-url("icons/tool-mosaic.svg"), @image-url("icons/tool-crop.svg"), @image-url("icons/tool-hand.svg"), @image-url("icons/tool-shapes.svg"), @image-url("icons/tool-redact-box.svg"), @image-url("icons/tool-redact-brush.svg")];

    property <[MItem]> m-file: [
        { label: T.t("新增", "New"), act: "new", enabled: true, key: "Ctrl+N", icon: @image-url("icons/new.svg") },
        { label: T.t("開啟…", "Open…"), act: "open", enabled: true, key: "Ctrl+O", icon: @image-url("icons/open.svg") },
        { label: T.t("開啟資料夾…", "Open folder…"), act: "open-folder", enabled: true, icon: @image-url("icons/folder.svg") },
        { label: T.t("開啟專案…", "Open project…"), act: "open-project", enabled: true, icon: @image-url("icons/project-open.svg") },
        { label: T.t("最近的檔案", "Recent files"), act: "recent-menu", enabled: root.recent-files.length > 0, icon: @image-url("icons/recent.svg") },
        { sep: true },
        { label: T.t("儲存", "Save"), act: "quick-save", enabled: true, key: "Ctrl+S", icon: @image-url("icons/save.svg") },
        { label: T.t("另存新檔…", "Save as…"), act: "save-as", enabled: true, key: "Ctrl+Shift+S", icon: @image-url("icons/save-as.svg") },
        { label: T.t("儲存專案…", "Save project…"), act: "save-project", enabled: true, icon: @image-url("icons/project-save.svg") },
        { label: T.t("匯出…", "Export…"), act: "export", enabled: true, key: "Ctrl+E", icon: @image-url("icons/export.svg") },
        { sep: true },
        { label: T.t("列印…", "Print…"), act: "print", enabled: true, key: "Ctrl+P", icon: @image-url("icons/print.svg") },
        { label: T.t("內容…", "Properties…"), act: "properties", enabled: true, key: "Alt+Enter", icon: @image-url("icons/properties.svg") },
        { sep: true },
        { label: T.t("結束", "Exit"), act: "exit", enabled: true, key: "Alt+F4", icon: @image-url("icons/exit.svg") }
    ];
    property <[MItem]> m-edit: [
        { label: T.t("復原", "Undo"), act: "undo", enabled: root.can-undo, key: "Ctrl+Z", icon: @image-url("icons/undo.svg") },
        { label: T.t("重做", "Redo"), act: "redo", enabled: root.can-redo, key: "Ctrl+Y", icon: @image-url("icons/redo.svg") },
        { sep: true },
        { label: T.t("剪下", "Cut"), act: "cut", enabled: root.has-selection || root.has-layer, key: "Ctrl+X", icon: @image-url("icons/cut.svg") },
        { label: T.t("複製", "Copy"), act: "copy", enabled: true, key: "Ctrl+C", icon: @image-url("icons/copy.svg") },
        { label: T.t("貼上（為圖層）", "Paste (as layer)"), act: "paste-layer", enabled: true, key: "Ctrl+Shift+V", icon: @image-url("icons/paste-layer.svg") },
        { label: T.t("貼上為新影像", "Paste as new image"), act: "paste", enabled: true, key: "Ctrl+V", icon: @image-url("icons/paste-new.svg") },
        { sep: true },
        { label: T.t("全選", "Select all"), act: "select-all", enabled: true, key: "Ctrl+A", icon: @image-url("icons/select-all.svg") },
        { label: T.t("取消選取", "Deselect"), act: "deselect", enabled: root.has-selection, key: "Ctrl+D", icon: @image-url("icons/deselect.svg") },
        { label: T.t("刪除", "Delete"), act: "delete", enabled: root.has-selection || root.has-layer, key: "Del", icon: @image-url("icons/delete.svg") },
        { sep: true },
        { label: T.t("截圖", "Screenshot"), act: "screenshot", enabled: true, icon: @image-url("icons/screenshot.svg") }
    ];
    property <[MItem]> m-view: [
        { label: T.t("放大", "Zoom in"), act: "zoom-in", enabled: true, key: "Ctrl++", icon: @image-url("icons/zoom-in.svg") },
        { label: T.t("縮小", "Zoom out"), act: "zoom-out", enabled: true, key: "Ctrl+-", icon: @image-url("icons/zoom-out.svg") },
        { label: T.t("符合視窗", "Zoom to fit"), act: "zoom-fit", enabled: true, key: "Ctrl+0", icon: @image-url("icons/zoom-fit.svg") },
        { label: T.t("實際大小 (100%)", "Actual size (100%)"), act: "zoom-100", enabled: true, key: "1", icon: @image-url("icons/zoom-100.svg") },
        { sep: true },
        { label: T.t("像素格線", "Pixel grid"), act: "toggle-grid", enabled: true, key: "Ctrl+G", check: true, checked: root.grid-on },
        { label: T.t("尺規", "Rulers"), act: "toggle-rulers", enabled: true, key: "Ctrl+R", check: true, checked: root.show-rulers },
        { label: T.t("浮動工具列", "Floating toolbar"), act: "toggle-toolbar", enabled: true, check: true, checked: root.tb-mode != 2 },
        { label: T.t("狀態列", "Status bar"), act: "toggle-status", enabled: true, check: true, checked: root.show-status },
        { sep: true },
        { label: T.t("全螢幕", "Full screen"), act: "fullscreen", enabled: true, key: "F11", check: true, checked: root.full-screen-on },
        { label: T.t("檢視模式", "Viewer mode"), act: "toggle-mode", enabled: true, check: true, checked: root.view-mode }
    ];
    property <[MItem]> m-image: [
        { label: T.t("裁切到選取區", "Crop to selection"), act: "crop", enabled: root.has-selection, key: "Enter", icon: @image-url("icons/crop.svg") },
        { label: T.t("調整影像大小…", "Resize image…"), act: "resize-dialog", enabled: true, key: "Ctrl+W", icon: @image-url("icons/resize.svg") },
        { label: T.t("畫布大小…", "Canvas size…"), act: "resize-dialog", enabled: true, key: "Ctrl+Shift+W", icon: @image-url("icons/canvas-size.svg") },
        { sep: true },
        { label: T.t("逆時針旋轉 90°", "Rotate 90° left"), act: "rot-left", enabled: true, icon: @image-url("icons/rot-left.svg") },
        { label: T.t("順時針旋轉 90°", "Rotate 90° right"), act: "rot-right", enabled: true, icon: @image-url("icons/rot-right.svg") },
        { label: T.t("旋轉 180°", "Rotate 180°"), act: "rot-180", enabled: true, icon: @image-url("icons/rot-180.svg") },
        { label: T.t("水平翻轉", "Flip horizontal"), act: "flip-h", enabled: true, icon: @image-url("icons/flip-h.svg") },
        { label: T.t("垂直翻轉", "Flip vertical"), act: "flip-v", enabled: true, icon: @image-url("icons/flip-v.svg") },
        { sep: true },
        { label: T.t("調整…", "Adjustments…"), act: "tab:2", enabled: true, icon: @image-url("icons/adjust.svg") },
        { label: T.t("灰階", "Grayscale"), act: "f-gray", enabled: true, icon: @image-url("icons/grayscale.svg") },
        { label: T.t("負片", "Invert colours"), act: "f-invert", enabled: true, icon: @image-url("icons/invert.svg") },
        { label: T.t("自動對比", "Auto contrast"), act: "f-auto", enabled: true, icon: @image-url("icons/auto-contrast.svg") },
        { label: T.t("還原成原始影像", "Reset to original"), act: "reset", enabled: true, icon: @image-url("icons/reset.svg") }
    ];
    property <[MItem]> m-layer: [
        { label: T.t("新增文字圖層", "New text layer"), act: "add-text", enabled: true, icon: @image-url("icons/add-text.svg") },
        { label: T.t("從檔案新增圖片圖層…", "New image layer from file…"), act: "add-image", enabled: true, icon: @image-url("icons/add-image.svg") },
        { label: T.t("貼上為圖層", "Paste as layer"), act: "paste-layer", enabled: true, key: "Ctrl+Shift+V", icon: @image-url("icons/paste-layer.svg") },
        { sep: true },
        { label: T.t("複製圖層", "Duplicate layer"), act: "layer-dup", enabled: root.has-layer, key: "Ctrl+J", icon: @image-url("icons/layer-dup.svg") },
        { label: T.t("刪除圖層", "Delete layer"), act: "layer-delete", enabled: root.has-layer, key: "Del", icon: @image-url("icons/layer-delete.svg") },
        { label: T.t("合併所有圖層", "Merge all layers"), act: "flatten", enabled: root.layers.length > 0, key: "Ctrl+Shift+E", icon: @image-url("icons/flatten.svg") },
        { sep: true },
        { label: T.t("上移一層", "Bring forward"), act: "layer-up", enabled: root.has-layer, key: "Ctrl+]", icon: @image-url("icons/layer-up.svg") },
        { label: T.t("下移一層", "Send backward"), act: "layer-down", enabled: root.has-layer, key: "Ctrl+[", icon: @image-url("icons/layer-down.svg") },
        { label: T.t("圖層面板", "Layers panel"), act: "tab:1", enabled: true, icon: @image-url("icons/tab-layers.svg") }
    ];
    property <[MItem]> m-tools: [
        { label: T.t("貼圖", "Stickers"), act: "tab:3", enabled: true, icon: @image-url("icons/tab-stickers.svg") },
        { label: T.t("自動打碼", "Auto redact"), act: "tab:4", enabled: true, icon: @image-url("icons/tab-redact.svg") },
        { label: T.t("C2PA 內容憑證…", "C2PA content credentials…"), act: "c2pa-dialog", enabled: true, icon: @image-url("icons/c2pa.svg") },
        { sep: true },
        { label: T.t("批次轉檔", "Batch convert"), act: "tab:6", enabled: true, icon: @image-url("icons/tab-batch.svg") },
        { label: T.t("GIF 動畫", "Animated GIF"), act: "tab:6", enabled: true, icon: @image-url("icons/gif.svg") },
        { label: T.t("360° 全景", "360° panorama"), act: "tab:6", enabled: true, icon: @image-url("icons/panorama.svg") },
        { sep: true },
        { label: T.t("設定", "Settings"), act: "tab:7", enabled: true, icon: @image-url("icons/tab-settings.svg") }
    ];
    property <[MItem]> m-help: [
        { label: T.t("鍵盤快捷鍵", "Keyboard shortcuts"), act: "shortcuts", enabled: true, key: "F1", icon: @image-url("icons/keyboard.svg") },
        { label: T.t("關於 Pixel Studio", "About Pixel Studio"), act: "about", enabled: true, icon: @image-url("icons/about.svg") }
    ];
    property <[MTitle]> menu-titles: [{ zh: "檔案", en-rest: "ile", key: "F" }, { zh: "編輯", en-rest: "dit", key: "E" }, { zh: "檢視", en-rest: "iew", key: "V" }, { zh: "影像", en-rest: "mage", key: "I" }, { zh: "圖層", en-rest: "ayer", key: "L" }, { zh: "工具", en-rest: "ools", key: "T" }, { zh: "說明", en-rest: "elp", key: "H" }];
    property <[MItem]> cur-items: root.menu-open == 0 ? root.m-file : root.menu-open == 1 ? root.m-edit : root.menu-open == 2 ? root.m-view : root.menu-open == 3 ? root.m-image : root.menu-open == 4 ? root.m-layer : root.menu-open == 5 ? root.m-tools : root.m-help;
    function open-menu(i: int) {
        Tip.text = "";
        root.recent-open = false;
        root.menu-open = i;
        root.menu-hl = -1;
        fs.focus();
    }
    function menu-step(d: int) {
        if (root.menu-hl < 0 && d < 0) {
            root.menu-hl = root.cur-items.length - 1;
        } else {
            root.menu-hl = mod(root.menu-hl + d + root.cur-items.length, root.cur-items.length);
        }
        if (root.cur-items[root.menu-hl].sep || !root.cur-items[root.menu-hl].enabled) {
            root.menu-hl = mod(root.menu-hl + d + root.cur-items.length, root.cur-items.length);
        }
    }
    function run-item(m: MItem) {
        if (!m.enabled || m.sep) { return; }
        if (m.act == "recent-menu") { root.recent-open = !root.recent-open; return; }
        root.menu-open = -1;
        root.recent-open = false;
        root.action(m.act);
    }
    // ---------------------------------------------------------------- callbacks
    callback toolbar-moved();
    callback action(string);
    in property <int> canvas-cursor;
    callback canvas-pointer(int, int, length, length, bool, bool); // kind 0 down 1 up 2 move 3 cancel, button 0 left 1 right 2 middle
    callback canvas-scroll(length, length, length, bool);
    callback canvas-resized();
    callback key(string, bool, bool) -> bool;
    callback pick-color(color, bool);
    callback select-layer(int);
    callback toggle-layer(int);
    callback layer-edited(string);
    callback sticker-click(string);
    callback sticker-drop(string, length, length);
    callback sticker-search();
    callback toggle-box(int);
    callback apply-preset(int);
    callback text-style(int);
    callback tool-changed(int);
    callback language-changed(int);

    changed canvas-w => { root.canvas-resized(); }

    fs := FocusScope {
        key-pressed(e) => {
            if (e.modifiers.alt && !e.modifiers.control) {
                if (e.text == "f" || e.text == "F") { root.open-menu(0); return accept; }
                if (e.text == "e" || e.text == "E") { root.open-menu(1); return accept; }
                if (e.text == "v" || e.text == "V") { root.open-menu(2); return accept; }
                if (e.text == "i" || e.text == "I") { root.open-menu(3); return accept; }
                if (e.text == "l" || e.text == "L") { root.open-menu(4); return accept; }
                if (e.text == "t" || e.text == "T") { root.open-menu(5); return accept; }
                if (e.text == "h" || e.text == "H") { root.open-menu(6); return accept; }
                if (e.text == Key.Return) { root.action("properties"); return accept; }
            }
            if (root.menu-open >= 0) {
                if (e.text == Key.Escape) { root.menu-open = -1; return accept; }
                if (e.text == Key.LeftArrow) { root.open-menu(mod(root.menu-open + 6, 7)); return accept; }
                if (e.text == Key.RightArrow) { root.open-menu(mod(root.menu-open + 1, 7)); return accept; }
                if (e.text == Key.DownArrow) { root.menu-step(1); return accept; }
                if (e.text == Key.UpArrow) { root.menu-step(-1); return accept; }
                if (e.text == Key.Return || e.text == " ") {
                    if (root.menu-hl >= 0) { root.run-item(root.cur-items[root.menu-hl]); }
                    return accept;
                }
                return accept;
            }
            if (e.text == Key.F1) { root.keys-open = true; return accept; }
            if (e.text == Key.Escape && (root.about-open || root.keys-open || root.props-open || root.rs-open || root.c2pa-open || root.qs-open)) {
                root.about-open = false; root.keys-open = false; root.props-open = false; root.rs-open = false; root.c2pa-open = false; root.qs-open = false;
                return accept;
            }
            if (root.key(e.text, e.modifiers.control || e.modifiers.meta, e.modifiers.shift)) { return accept; }
            return reject;
        }

    VerticalLayout {
        // ------------------------------------------------------------ menu bar (drawn as an overlay at the end; this reserves its space)
        Rectangle { height: 26px; }
        // ------------------------------------------------------------ top bar (icon-only)
        Rectangle {
            background: #ffffff;
            height: 40px;
            HorizontalLayout {
                padding: 5px;
                spacing: 2px;
                IBtn { icon: @image-url("icons/new.svg"); tip: T.t("新增 (Ctrl+N)", "New (Ctrl+N)"); clicked => { root.action("new"); } }
                IBtn { icon: @image-url("icons/open.svg"); tip: T.t("開啟 (Ctrl+O)", "Open (Ctrl+O)"); clicked => { root.action("open"); } }
                IBtn { icon: @image-url("icons/folder.svg"); tip: T.t("開啟資料夾", "Open folder"); clicked => { root.action("open-folder"); } }
                IBtn { icon: @image-url("icons/save.svg"); tip: T.t("儲存 (Ctrl+S)", "Save (Ctrl+S)"); clicked => { root.action("save"); } }
                IBtn { icon: @image-url("icons/save-as.svg"); tip: T.t("另存新檔 (Ctrl+Shift+S)", "Save as (Ctrl+Shift+S)"); clicked => { root.action("save-as"); } }
                IBtn { icon: @image-url("icons/project-open.svg"); tip: T.t("開啟專案", "Open project"); clicked => { root.action("open-project"); } }
                IBtn { icon: @image-url("icons/project-save.svg"); tip: T.t("儲存專案", "Save project"); clicked => { root.action("save-project"); } }
                Rectangle { width: 1px; background: #dde2e8; }
                IBtn { icon: @image-url("icons/undo.svg"); tip: T.t("復原 (Ctrl+Z)", "Undo (Ctrl+Z)"); enabled: root.can-undo; clicked => { root.action("undo"); } }
                IBtn { icon: @image-url("icons/redo.svg"); tip: T.t("重做 (Ctrl+Y)", "Redo (Ctrl+Y)"); enabled: root.can-redo; clicked => { root.action("redo"); } }
                IBtn { icon: @image-url("icons/cut.svg"); tip: T.t("剪下 (Ctrl+X)", "Cut (Ctrl+X)"); enabled: root.has-selection || root.has-layer; clicked => { root.action("cut"); } }
                IBtn { icon: @image-url("icons/copy.svg"); tip: T.t("複製 (Ctrl+C)", "Copy (Ctrl+C)"); clicked => { root.action("copy"); } }
                IBtn { icon: @image-url("icons/paste.svg"); tip: T.t("貼上為新影像 (Ctrl+V)", "Paste as new image (Ctrl+V)"); clicked => { root.action("paste"); } }
                IBtn { icon: @image-url("icons/screenshot.svg"); tip: T.t("截圖", "Screenshot"); clicked => { root.action("screenshot"); } }
                Rectangle { width: 1px; background: #dde2e8; }
                IBtn { icon: @image-url("icons/zoom-out.svg"); tip: T.t("縮小 (-)", "Zoom out (-)"); clicked => { root.action("zoom-out"); } }
                Text { text: round(root.zoom * 100) + "%"; vertical-alignment: center; width: 46px; horizontal-alignment: center; color: #33475b; }
                IBtn { icon: @image-url("icons/zoom-in.svg"); tip: T.t("放大 (+)", "Zoom in (+)"); clicked => { root.action("zoom-in"); } }
                IBtn { icon: @image-url("icons/zoom-fit.svg"); tip: T.t("符合視窗 (0)", "Zoom to fit (0)"); clicked => { root.action("zoom-fit"); } }
                IBtn { icon: @image-url("icons/zoom-100.svg"); tip: T.t("實際大小 (1)", "Actual size (1)"); clicked => { root.action("zoom-100"); } }
                IBtn { icon: @image-url("icons/grid.svg"); tip: T.t("像素格線 (Ctrl+G)", "Pixel grid (Ctrl+G)"); active: root.grid-on; clicked => { root.action("toggle-grid"); } }
                IBtn { icon: @image-url("icons/ruler.svg"); tip: T.t("尺規 (Ctrl+R)", "Rulers (Ctrl+R)"); active: root.show-rulers; clicked => { root.action("toggle-rulers"); } }
                Rectangle { width: 1px; background: #dde2e8; }
                IBtn { icon: @image-url("icons/prev.svg"); tip: T.t("上一張 (左方向鍵)", "Previous image (Left)"); clicked => { root.action("prev"); } }
                IBtn { icon: @image-url("icons/next.svg"); tip: T.t("下一張 (右方向鍵)", "Next image (Right)"); clicked => { root.action("next"); } }
                Rectangle { horizontal-stretch: 1; }
                IBtn { icon: @image-url("icons/toolbar.svg"); tip: root.tb-mode == 2 ? T.t("顯示浮動工具列", "Show floating toolbar") : T.t("隱藏浮動工具列", "Hide floating toolbar"); active: root.tb-mode != 2; clicked => { root.action("toggle-toolbar"); } }
                IBtn { icon: @image-url("icons/fullscreen.svg"); tip: T.t("全螢幕 (F11)", "Full screen (F11)"); active: root.full-screen-on; clicked => { root.action("fullscreen"); } }
                IBtn { icon: root.view-mode ? @image-url("icons/mode-view.svg") : @image-url("icons/mode-edit.svg"); tip: root.view-mode ? T.t("檢視模式（按一下切換到編輯）", "Viewer mode (click for editor)") : T.t("編輯模式（按一下切換到檢視）", "Editor mode (click for viewer)"); clicked => { root.action("toggle-mode"); } }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            // -------------------------------------------------------- tool column
            if !root.view-mode: Rectangle {
                width: 112px;
                background: #f8f9fb;
                ScrollView {
                    VerticalLayout {
                        padding: 6px;
                        spacing: 3px;
                        alignment: start;
                        Rectangle {
                            height: ceil(root.tools.length / 3) * 33px;
                            for t[i] in root.tools: IBtn {
                                x: mod(i, 3) * 33px;
                                y: floor(i / 3) * 33px;
                                icon: root.tool-icons[i];
                                active: root.tool == i;
                                tip: T.t(t.zh, t.en) + " (" + root.tool-keys[i] + ")";
                                clicked => { root.tool = i; root.tool-changed(i); fs.focus(); }
                            }
                        }
                        Rectangle { height: 8px; }
                        Text { text: T.t("顏色 1 / 2", "Colour 1 / 2"); font-size: 11px; }
                        HorizontalLayout {
                            spacing: 4px;
                            Rectangle { width: 28px; height: 28px; background: root.color1; border-width: 2px; border-color: #333; border-radius: 4px; }
                            Rectangle { width: 28px; height: 28px; background: root.color2; border-width: 1px; border-color: #999; border-radius: 4px; }
                            IBtn { icon: @image-url("icons/swap.svg"); size: 28px; tip: T.t("交換色 1 / 色 2 (X)", "Swap colours 1 / 2 (X)"); clicked => { root.action("swap-colors"); } }
                        }
                        Text { text: T.t("左鍵=色1 右鍵=色2", "L=colour 1  R=colour 2"); font-size: 10px; color: #666; wrap: word-wrap; }
                        GridLayout {
                            spacing: 3px;
                            for c[i] in root.palette: Swatch {
                                row: floor(i / 4);
                                col: mod(i, 4);
                                c: c;
                                pick(right) => { root.pick-color(c, right); }
                            }
                        }
                        hex := LineEdit { placeholder-text: "#RRGGBB"; accepted(t) => { root.action("hex:" + t); } }
                    }
                }
            }
            // -------------------------------------------------------- canvas
            canvas-area := Rectangle {
                horizontal-stretch: 1;
                background: #c9ced6;
                clip: true;
                // checkerboard behind transparent pixels
                Rectangle {
                    x: root.pan-x; y: root.pan-y;
                    width: root.img-w * root.zoom * 1px;
                    height: root.img-h * root.zoom * 1px;
                    background: #ffffff;
                    drop-shadow-blur: 8px;
                    drop-shadow-color: #0004;
                }
                Image {
                    x: root.pan-x; y: root.pan-y;
                    width: root.img-w * root.zoom * 1px;
                    height: root.img-h * root.zoom * 1px;
                    source: root.canvas;
                    image-rendering: root.pixelated ? ImageRendering.pixelated : ImageRendering.smooth;
                    image-fit: fill;
                }
                if root.show-grid-overlay: Path {
                    x: 0; y: 0;
                    width: canvas-area.width; height: canvas-area.height;
                    viewbox-x: 0; viewbox-y: 0;
                    viewbox-width: canvas-area.width / 1px; viewbox-height: canvas-area.height / 1px;
                    commands: root.grid-path;
                    stroke: #0003;
                    stroke-width: 1px;
                }
                if root.has-selection: Rectangle {
                    x: root.pan-x + root.sel-x * root.zoom * 1px;
                    y: root.pan-y + root.sel-y * root.zoom * 1px;
                    width: root.sel-w * root.zoom * 1px;
                    height: root.sel-h * root.zoom * 1px;
                    border-width: 1.5px;
                    border-color: #2f6fed;
                    border-radius: root.sel-circle ? self.width / 2 : 0;
                    background: #2f6fed18;
                }
                if root.has-preview: Rectangle {
                    x: root.pan-x + root.pv-x * root.zoom * 1px;
                    y: root.pan-y + root.pv-y * root.zoom * 1px;
                    width: root.pv-w * root.zoom * 1px;
                    height: root.pv-h * root.zoom * 1px;
                    border-width: 1.5px;
                    border-color: #e53935;
                    background: #e5393520;
                }
                if root.show-boxes: Rectangle {
                    for b in root.boxes: Rectangle {
                        x: root.pan-x + b.x * root.zoom * 1px;
                        y: root.pan-y + b.y * root.zoom * 1px;
                        width: b.w * root.zoom * 1px;
                        height: b.h * root.zoom * 1px;
                        border-width: 2px;
                        border-color: b.selected ? #e53935 : #1e88e5;
                        background: b.selected ? #e5393540 : #1e88e518;
                        if b.label != "": Rectangle {
                            x: 0; y: -14px; height: 14px; width: lbl.preferred-width + 6px;
                            background: b.selected ? #e53935 : #1e88e5;
                            lbl := Text { text: b.label; color: white; font-size: 10px; }
                        }
                        if root.tool == 14: Rectangle {
                            x: parent.width - 5px; y: parent.height - 5px; width: 10px; height: 10px;
                            background: b.selected ? #e53935 : #1e88e5; border-width: 1px; border-color: white;
                        }
                    }
                }
                if root.show-edge-handles: Rectangle {
                    property <length> iw: root.img-w * root.zoom * 1px;
                    property <length> ih: root.img-h * root.zoom * 1px;
                    Rectangle { x: root.pan-x + iw; y: root.pan-y + ih / 2 - 6px; width: 7px; height: 12px; background: #607d8b; border-radius: 2px; }
                    Rectangle { x: root.pan-x + iw / 2 - 6px; y: root.pan-y + ih; width: 12px; height: 7px; background: #607d8b; border-radius: 2px; }
                    Rectangle { x: root.pan-x + iw; y: root.pan-y + ih; width: 9px; height: 9px; background: #607d8b; border-radius: 2px; }
                }
                if root.has-layer-box: Rectangle {
                    x: root.pan-x + root.lb-x * root.zoom * 1px - 2px;
                    y: root.pan-y + root.lb-y * root.zoom * 1px - 2px;
                    width: root.lb-w * root.zoom * 1px + 4px;
                    height: root.lb-h * root.zoom * 1px + 4px;
                    border-width: 1px;
                    border-color: #ff9800;
                    if root.lb-handle: Rectangle {
                        x: parent.width - 6px; y: parent.height - 6px; width: 12px; height: 12px;
                        background: #ff9800; border-width: 1px; border-color: white;
                    }
                }
                TouchArea {
                    mouse-cursor: !self.has-hover && !self.pressed ? MouseCursor.default :
                        root.canvas-cursor == 1 ? MouseCursor.grab :
                        root.canvas-cursor == 2 ? MouseCursor.grabbing :
                        root.canvas-cursor == 3 ? MouseCursor.nwse-resize :
                        root.canvas-cursor == 4 ? MouseCursor.ew-resize :
                        root.canvas-cursor == 5 ? MouseCursor.ns-resize : MouseCursor.crosshair;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) { fs.focus(); }
                        root.canvas-pointer(
                            e.kind == PointerEventKind.down ? 0 : e.kind == PointerEventKind.up ? 1 : e.kind == PointerEventKind.move ? 2 : 3,
                            e.button == PointerEventButton.right ? 1 : e.button == PointerEventButton.middle ? 2 : 0,
                            self.mouse-x, self.mouse-y, e.modifiers.shift, e.modifiers.control);
                    }
                    scroll-event(e) => {
                        root.canvas-scroll(self.mouse-x, self.mouse-y, e.delta-y, e.modifiers.control);
                        return accept;
                    }
                }
                // ---------------- rulers
                if root.show-rulers: Rectangle {
                    x: 0; y: 0; width: canvas-area.width; height: 18px;
                    background: #f4f6f9;
                    Rectangle { y: parent.height - 1px; height: 1px; background: #b9c1cb; }
                    for tk in root.ruler-x: Rectangle {
                        x: tk.pos; y: tk.major ? 6px : 12px; width: 1px; height: tk.major ? 12px : 6px; background: #7d8894;
                        if tk.label != "": Text { x: 3px; y: -6px; text: tk.label; font-size: 9px; color: #55606c; }
                    }
                }
                if root.show-rulers: Rectangle {
                    x: 0; y: 18px; width: 18px; height: canvas-area.height - 18px;
                    background: #f4f6f9;
                    Rectangle { x: parent.width - 1px; width: 1px; background: #b9c1cb; }
                    for tk in root.ruler-y: Rectangle {
                        y: tk.pos - 18px; x: tk.major ? 6px : 12px; height: 1px; width: tk.major ? 12px : 6px; background: #7d8894;
                        if tk.label != "": Text { x: -5px; y: 2px; text: tk.label; font-size: 9px; color: #55606c; }
                    }
                }
                // ---------------- floating / docked quick-action toolbar
                if root.tb-mode != 2: Rectangle {
                    x: root.tb-mode == 1 ? (root.show-rulers ? 18px : 0px) : clamp(root.tb-x, root.show-rulers ? 20px : 0px, max(0px, canvas-area.width - self.width));
                    y: root.tb-mode == 1 ? (root.show-rulers ? 18px : 0px) : clamp(root.tb-y, root.show-rulers ? 20px : 0px, max(0px, canvas-area.height - self.height));
                    width: root.tb-mode == 1 ? canvas-area.width - (root.show-rulers ? 18px : 0px) : tbl.preferred-width;
                    height: 36px;
                    background: #ffffffee;
                    border-radius: root.tb-mode == 1 ? 0 : 6px;
                    drop-shadow-blur: root.tb-mode == 1 ? 0 : 6px;
                    drop-shadow-color: #0003;
                    tbl := HorizontalLayout {
                        padding: 4px;
                        spacing: 2px;
                        alignment: start;
                        Rectangle {
                            width: 14px;
                            Image { source: @image-url("icons/grip.svg"); width: 14px; height: 14px; colorize: #8a96a3; }
                            grip := TouchArea {
                                mouse-cursor: root.tb-mode != 0 ? MouseCursor.default : self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                                moved => {
                                    if (root.tb-mode == 0) {
                                        root.tb-x = clamp(root.tb-x + self.mouse-x - self.pressed-x, 0, canvas-area.width - 60px);
                                        root.tb-y = clamp(root.tb-y + self.mouse-y - self.pressed-y, 0, canvas-area.height - 30px);
                                    }
                                }
                                pointer-event(e) => { if (e.kind == PointerEventKind.up) { root.toolbar-moved(); } }
                            }
                        }
                        IBtn { icon: @image-url("icons/undo.svg"); size: 28px; tip: T.t("復原 (Ctrl+Z)", "Undo (Ctrl+Z)"); enabled: root.can-undo; clicked => { root.action("undo"); } }
                        IBtn { icon: @image-url("icons/redo.svg"); size: 28px; tip: T.t("重做 (Ctrl+Y)", "Redo (Ctrl+Y)"); enabled: root.can-redo; clicked => { root.action("redo"); } }
                        IBtn { icon: @image-url("icons/save.svg"); size: 28px; tip: T.t("快速儲存 (Ctrl+S)", "Quick save (Ctrl+S)"); clicked => { root.action("quick-save"); } }
                        IBtn { icon: @image-url("icons/save-as.svg"); size: 28px; tip: T.t("另存新檔 (Ctrl+Shift+S)", "Save as (Ctrl+Shift+S)"); clicked => { root.action("save-as"); } }
                        IBtn { icon: @image-url("icons/copy.svg"); size: 28px; tip: T.t("複製影像或選取區 (Ctrl+C)", "Copy image or selection (Ctrl+C)"); clicked => { root.action("copy"); } }
                        IBtn { icon: @image-url("icons/paste.svg"); size: 28px; tip: T.t("貼上為新影像 (Ctrl+V)", "Paste as new image (Ctrl+V)"); clicked => { root.action("paste"); } }
                        IBtn { icon: @image-url("icons/crop.svg"); size: 28px; tip: T.t("裁切到選取區 (Enter)", "Crop to selection (Enter)"); enabled: root.has-selection; clicked => { root.action("crop"); } }
                        IBtn { icon: @image-url("icons/rot-right.svg"); size: 28px; tip: T.t("順時針旋轉 90°", "Rotate 90° clockwise"); clicked => { root.action("rot-right"); } }
                        IBtn { icon: @image-url("icons/zoom-fit.svg"); size: 28px; tip: T.t("符合視窗 (0)", "Zoom to fit (0)"); clicked => { root.action("zoom-fit"); } }
                        IBtn { icon: @image-url("icons/zoom-100.svg"); size: 28px; tip: T.t("實際大小 100% (1)", "Actual size 100% (1)"); clicked => { root.action("zoom-100"); } }
                        IBtn { icon: @image-url("icons/grid.svg"); size: 28px; tip: T.t("切換像素格線 (Ctrl+G，放大 8 倍以上顯示)", "Toggle pixel grid (Ctrl+G, shown at 800%+)"); active: root.grid-on; clicked => { root.action("toggle-grid"); } }
                        IBtn { icon: root.tb-mode == 1 ? @image-url("icons/float.svg") : @image-url("icons/dock.svg"); size: 28px; tip: root.tb-mode == 1 ? T.t("改為浮動", "Float toolbar") : T.t("停駐到上方", "Dock to top"); clicked => { root.tb-mode = root.tb-mode == 1 ? 0 : 1; root.toolbar-moved(); } }
                        IBtn { icon: @image-url("icons/close.svg"); size: 28px; tip: T.t("隱藏工具列（檢視 > 浮動工具列可再開）", "Hide toolbar (View > Floating toolbar)"); clicked => { root.tb-mode = 2; root.toolbar-moved(); } }
                    }
                }
                // ---------------- canvas context menu
                if root.ctx-open: TouchArea {
                    clicked => { root.ctx-open = false; }
                    pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) { root.ctx-open = false; } }
                }
                if root.ctx-open: Rectangle {
                    x: min(root.ctx-x, canvas-area.width - self.width - 4px);
                    y: min(root.ctx-y, canvas-area.height - self.height - 4px);
                    width: 230px;
                    height: ctxl.preferred-height;
                    background: white;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #d0d6de;
                    drop-shadow-blur: 8px;
                    drop-shadow-color: #0004;
                    ctxl := VerticalLayout {
                        padding-top: 4px; padding-bottom: 4px;
                        MenuRow { icon: @image-url("icons/undo.svg"); label: T.t("復原", "Undo"); shortcut: "Ctrl+Z"; enabled: root.can-undo; clicked => { root.ctx-open = false; root.action("undo"); } }
                        MenuRow { icon: @image-url("icons/redo.svg"); label: T.t("重做", "Redo"); shortcut: "Ctrl+Y"; enabled: root.can-redo; clicked => { root.ctx-open = false; root.action("redo"); } }
                        Rectangle { height: 1px; background: #e4e8ee; }
                        MenuRow { icon: @image-url("icons/copy.svg"); label: T.t("複製", "Copy"); shortcut: "Ctrl+C"; clicked => { root.ctx-open = false; root.action("copy"); } }
                        MenuRow { icon: @image-url("icons/paste.svg"); label: T.t("貼上為新影像", "Paste as new image"); shortcut: "Ctrl+V"; clicked => { root.ctx-open = false; root.action("paste"); } }
                        MenuRow { icon: @image-url("icons/paste-layer.svg"); label: T.t("貼上為圖層", "Paste as layer"); shortcut: "Ctrl+Shift+V"; clicked => { root.ctx-open = false; root.action("paste-layer"); } }
                        Rectangle { height: 1px; background: #e4e8ee; }
                        MenuRow { icon: @image-url("icons/select-all.svg"); label: T.t("全選", "Select all"); shortcut: "Ctrl+A"; clicked => { root.ctx-open = false; root.action("select-all"); } }
                        MenuRow { icon: @image-url("icons/deselect.svg"); label: T.t("取消選取", "Deselect"); shortcut: "Ctrl+D"; enabled: root.has-selection; clicked => { root.ctx-open = false; root.action("deselect"); } }
                        MenuRow { icon: @image-url("icons/crop.svg"); label: T.t("裁切到選取區", "Crop to selection"); shortcut: "Enter"; enabled: root.has-selection; clicked => { root.ctx-open = false; root.action("crop"); } }
                        MenuRow { icon: @image-url("icons/layer-delete.svg"); label: T.t("刪除圖層", "Delete layer"); shortcut: "Del"; enabled: root.has-layer; clicked => { root.ctx-open = false; root.action("layer-delete"); } }
                        Rectangle { height: 1px; background: #e4e8ee; }
                        MenuRow { icon: @image-url("icons/rot-right.svg"); label: T.t("順時針旋轉 90°", "Rotate 90° right"); clicked => { root.ctx-open = false; root.action("rot-right"); } }
                        MenuRow { icon: @image-url("icons/rot-left.svg"); label: T.t("逆時針旋轉 90°", "Rotate 90° left"); clicked => { root.ctx-open = false; root.action("rot-left"); } }
                        MenuRow { icon: @image-url("icons/zoom-fit.svg"); label: T.t("符合視窗", "Zoom to fit"); shortcut: "0"; clicked => { root.ctx-open = false; root.action("zoom-fit"); } }
                        MenuRow { icon: @image-url("icons/zoom-100.svg"); label: T.t("實際大小", "Actual size"); shortcut: "1"; clicked => { root.ctx-open = false; root.action("zoom-100"); } }
                        MenuRow { icon: @image-url("icons/grid.svg"); label: root.grid-on ? T.t("隱藏像素格線", "Hide pixel grid") : T.t("顯示像素格線", "Show pixel grid"); shortcut: "Ctrl+G"; clicked => { root.ctx-open = false; root.action("toggle-grid"); } }
                        Rectangle { height: 1px; background: #e4e8ee; }
                        MenuRow { icon: @image-url("icons/save.svg"); label: T.t("快速儲存", "Quick save"); shortcut: "Ctrl+S"; clicked => { root.ctx-open = false; root.action("quick-save"); } }
                        MenuRow { icon: @image-url("icons/save-as.svg"); label: T.t("另存新檔…", "Save as…"); shortcut: "Ctrl+Shift+S"; clicked => { root.ctx-open = false; root.action("save-as"); } }
                    }
                }
            }
            // -------------------------------------------------------- inspector
            if !root.view-mode: Rectangle {
                width: 372px;
                background: #ffffff;
                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: space-between;
                        IBtn { icon: @image-url("icons/tab-tools.svg"); size: 38px; icon-size: 20px; active: root.tab == 0; tip: T.t("工具", "Tools"); clicked => { root.tab = 0;  } }
                        IBtn { icon: @image-url("icons/tab-layers.svg"); size: 38px; icon-size: 20px; active: root.tab == 1; tip: T.t("圖層", "Layers"); clicked => { root.tab = 1;  } }
                        IBtn { icon: @image-url("icons/tab-adjust.svg"); size: 38px; icon-size: 20px; active: root.tab == 2; tip: T.t("調整", "Adjust"); clicked => { root.tab = 2;  } }
                        IBtn { icon: @image-url("icons/tab-stickers.svg"); size: 38px; icon-size: 20px; active: root.tab == 3; tip: T.t("貼圖", "Stickers"); clicked => { root.tab = 3;  } }
                        IBtn { icon: @image-url("icons/tab-redact.svg"); size: 38px; icon-size: 20px; active: root.tab == 4; tip: T.t("自動打碼", "Auto redact"); clicked => { root.tab = 4; root.action("tab-redact"); } }
                        IBtn { icon: @image-url("icons/tab-info.svg"); size: 38px; icon-size: 20px; active: root.tab == 5; tip: T.t("資訊 / C2PA", "Info / C2PA"); clicked => { root.tab = 5; root.action("refresh-info"); } }
                        IBtn { icon: @image-url("icons/tab-batch.svg"); size: 38px; icon-size: 20px; active: root.tab == 6; tip: T.t("批次 / GIF / 全景", "Batch / GIF / panorama"); clicked => { root.tab = 6;  } }
                        IBtn { icon: @image-url("icons/tab-settings.svg"); size: 38px; icon-size: 20px; active: root.tab == 7; tip: T.t("設定", "Settings"); clicked => { root.tab = 7; root.action("refresh-shell"); } }
                    }
                    Text { text: [T.t("工具", "Tools"), T.t("圖層", "Layers"), T.t("調整", "Adjust"), T.t("貼圖", "Stickers"), T.t("自動打碼", "Auto redact"), T.t("資訊 / C2PA", "Info / C2PA"), T.t("批次 / GIF / 全景", "Batch / GIF / panorama"), T.t("設定", "Settings")][root.tab]; font-weight: 700; color: #1f3b63; }
                    Rectangle { height: 1px; background: #ddd; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding: 4px;
                            spacing: 6px;
                            alignment: start;
                            // ===== Tools
                            if root.tab == 0: VerticalLayout {
                                spacing: 6px;
                                Section { text: T.t("筆刷 / 形狀", "Brush / shape"); }
                                LabeledSlider { label: T.t("粗細", "Width"); minimum: 1; maximum: 120; value <=> root.stroke-width; has-apply: false; }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: T.t("形狀", "Shape"); vertical-alignment: center; width: 78px; }
                                    ComboBox {
                                        model: [T.t("直線", "Line"), T.t("箭頭", "Arrow"), T.t("矩形", "Rectangle"), T.t("橢圓", "Ellipse"), T.t("三角形", "Triangle")];
                                        current-index <=> root.shape-kind;
                                    }
                                }
                                CheckBox { text: T.t("形狀填滿（色 2）", "Fill shapes (colour 2)"); checked <=> root.shape-filled; }
                                LabeledSlider { label: T.t("填滿容差", "Fill tolerance"); minimum: 0; maximum: 128; value <=> root.fill-tolerance; has-apply: false; }
                                CheckBox { text: T.t("放大時顯示像素格線", "Pixel grid when zoomed in"); checked <=> root.show-grid; toggled => { root.action("grid"); } }
                                Section { text: T.t("匯出", "Export"); }
                                HorizontalLayout {
                                    spacing: 6px;
                                    ComboBox { model: root.format-names; current-index <=> root.export-format; }
                                    IBtn { icon: @image-url("icons/export.svg"); tip: T.t("匯出… (Ctrl+E)", "Export… (Ctrl+E)"); clicked => { root.action("export"); } }
                                }
                                LabeledSlider { label: T.t("品質", "Quality"); minimum: 1; maximum: 100; value <=> root.quality; has-apply: false; }
                                CheckBox { text: T.t("WebP 無損", "WebP lossless"); checked <=> root.webp-lossless; }
                                CheckBox { text: T.t("保留 EXIF/ICC 中繼資料", "Keep EXIF/ICC metadata"); checked <=> root.keep-metadata; }
                                Section { text: T.t("社群畫布尺寸", "Social canvas presets"); }
                                for p[i] in root.preset-names: Button { text: p; clicked => { root.apply-preset(i); } }
                                HorizontalLayout {
                                    spacing: 4px;
                                    SpinBox { minimum: 1; maximum: 16000; value <=> root.new-w; }
                                    Text { text: "×"; vertical-alignment: center; }
                                    SpinBox { minimum: 1; maximum: 16000; value <=> root.new-h; }
                                    IBtn { icon: @image-url("icons/new.svg"); tip: T.t("以此尺寸建立新畫布", "New canvas with this size"); clicked => { root.action("new-custom"); } }
                                }
                                Section { text: T.t("快速文字樣式", "Quick text styles"); }
                                LineEdit { text <=> root.style-text; }
                                HorizontalLayout {
                                    spacing: 4px;
                                    Button { text: T.t("外框", "Outline"); clicked => { root.text-style(0); } }
                                    Button { text: T.t("陰影", "Shadow"); clicked => { root.text-style(1); } }
                                    Button { text: T.t("框+影", "Both"); clicked => { root.text-style(2); } }
                                    Button { text: T.t("純文字", "Plain"); clicked => { root.text-style(3); } }
                                }
                            }
                            // ===== Layers
                            if root.tab == 1: VerticalLayout {
                                spacing: 6px;
                                Section { text: T.t("圖層（上方在前）", "Layers (top first)"); }
                                for l[i] in root.layers: Rectangle {
                                    height: 28px;
                                    border-radius: 4px;
                                    background: l.selected ? #dbe7ff : (lta.has-hover ? #f0f3f8 : #fafbfc);
                                    lta := TouchArea { clicked => { root.select-layer(i); } }
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        spacing: 6px;
                                        CheckBox { checked: l.visible; toggled => { root.toggle-layer(i); } }
                                        Image {
                                            width: 16px;
                                            height: 16px;
                                            y: (parent.height - self.height) / 2;
                                            source: l.kind == 0 ? @image-url("icons/layer-text.svg") : l.kind == 1 ? @image-url("icons/layer-image.svg") : l.kind == 2 ? @image-url("icons/layer-shape.svg") : @image-url("icons/layer-sticker.svg");
                                        }
                                        Text {
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            text: l.name;
                                        }
                                    }
                                }
                                if root.layers.length == 0: Text { text: T.t("尚無圖層。用文字/形狀工具、貼圖或「加入圖片」。", "No layers yet. Use Text/Shapes, stickers or Add image."); wrap: word-wrap; color: #666; }
                                HorizontalLayout {
                                    spacing: 2px;
                                    alignment: start;
                                    IBtn { icon: @image-url("icons/layer-up.svg"); tip: T.t("圖層上移 (Ctrl+])", "Move layer up (Ctrl+])"); enabled: root.has-layer; clicked => { root.action("layer-up"); } }
                                        IBtn { icon: @image-url("icons/layer-down.svg"); tip: T.t("圖層下移 (Ctrl+[)", "Move layer down (Ctrl+[)"); enabled: root.has-layer; clicked => { root.action("layer-down"); } }
                                        IBtn { icon: @image-url("icons/layer-dup.svg"); tip: T.t("複製圖層 (Ctrl+J)", "Duplicate layer (Ctrl+J)"); enabled: root.has-layer; clicked => { root.action("layer-dup"); } }
                                        IBtn { icon: @image-url("icons/layer-delete.svg"); tip: T.t("刪除圖層 (Del)", "Delete layer (Del)"); enabled: root.has-layer; clicked => { root.action("layer-delete"); } }
                                    Rectangle { width: 6px; }
                                    IBtn { icon: @image-url("icons/add-text.svg"); tip: T.t("新增文字圖層", "Add text layer"); clicked => { root.action("add-text"); } }
                                        IBtn { icon: @image-url("icons/add-image.svg"); tip: T.t("從檔案新增圖片圖層…", "Add image layer from file…"); clicked => { root.action("add-image"); } }
                                        IBtn { icon: @image-url("icons/paste-layer.svg"); tip: T.t("貼上為圖層 (Ctrl+Shift+V)", "Paste as layer (Ctrl+Shift+V)"); clicked => { root.action("paste-layer"); } }
                                        IBtn { icon: @image-url("icons/flatten.svg"); tip: T.t("合併所有圖層 (Ctrl+Shift+E)", "Flatten all layers (Ctrl+Shift+E)"); enabled: root.layers.length > 0; clicked => { root.action("flatten"); } }
                                }
                                if root.sel-kind >= 0: VerticalLayout {
                                    spacing: 6px;
                                    Section { text: T.t("選取的圖層", "Selected layer"); }
                                    LineEdit { text <=> root.l-name; edited => { root.layer-edited("name"); } }
                                    LabeledSlider { label: T.t("不透明度", "Opacity"); minimum: 0; maximum: 100; value <=> root.l-opacity; has-apply: false; changed value => { root.layer-edited("opacity"); } }
                                    if root.sel-kind == 0: VerticalLayout {
                                        spacing: 6px;
                                        TextEdit { height: 70px; text <=> root.l-text; edited => { root.layer-edited("text"); } }
                                        LabeledSlider { label: T.t("字級", "Size"); minimum: 6; maximum: 400; value <=> root.l-font-size; has-apply: false; changed value => { root.layer-edited("font-size"); } }
                                        ComboBox { model: root.font-names; current-index <=> root.l-font; selected => { root.layer-edited("font"); } }
                                        HorizontalLayout {
                                            CheckBox { text: T.t("外框", "Outline"); checked <=> root.l-stroke; toggled => { root.layer-edited("stroke"); } }
                                            CheckBox { text: T.t("陰影", "Shadow"); checked <=> root.l-shadow; toggled => { root.layer-edited("shadow"); } }
                                        }
                                        IBtn { icon: @image-url("icons/fill-color.svg"); tip: T.t("套用色 1 為文字顏色", "Use colour 1 for text"); clicked => { root.layer-edited("color"); } }
                                    }
                                    if root.sel-kind == 1 || root.sel-kind == 3: HorizontalLayout {
                                        spacing: 4px;
                                        SpinBox { minimum: 1; maximum: 16000; value <=> root.l-w; edited => { root.layer-edited("w"); } }
                                        Text { text: "×"; vertical-alignment: center; }
                                        SpinBox { minimum: 1; maximum: 16000; value <=> root.l-h; edited => { root.layer-edited("h"); } }
                                    }
                                    if root.sel-kind == 1 || root.sel-kind == 3: Text { text: T.t("在畫布上拖曳右下角控點可等比縮放。", "Drag the bottom-right handle on the canvas to resize."); font-size: 11px; color: #666; wrap: word-wrap; }
                                    if root.sel-kind == 2: VerticalLayout {
                                        spacing: 6px;
                                        LabeledSlider { label: T.t("線寬", "Line width"); minimum: 1; maximum: 60; value <=> root.l-stroke-width; has-apply: false; changed value => { root.layer-edited("stroke-width"); } }
                                        CheckBox { text: T.t("填滿", "Filled"); checked <=> root.l-filled; toggled => { root.layer-edited("filled"); } }
                                        IBtn { icon: @image-url("icons/fill-color.svg"); tip: T.t("線色=色 1 / 填色=色 2", "Stroke = colour 1 / fill = colour 2"); clicked => { root.layer-edited("color"); } }
                                    }
                                    if root.sel-kind == 3: Text { text: T.t("貼圖顏色與外框請在「貼圖」分頁調整。", "Sticker colours/outline: see the Stickers tab."); font-size: 11px; color: #666; wrap: word-wrap; }
                                }
                            }
                            // ===== Adjust
                            if root.tab == 2: VerticalLayout {
                                spacing: 6px;
                                Section { text: T.t("旋轉 / 翻轉", "Rotate / flip"); }
                                HorizontalLayout {
                                    spacing: 3px;
                                    alignment: start;
                                    IBtn { icon: @image-url("icons/rot-left.svg"); tip: T.t("逆時針旋轉 90°", "Rotate 90° left"); clicked => { root.action("rot-left"); } }
                                    IBtn { icon: @image-url("icons/rot-right.svg"); tip: T.t("順時針旋轉 90°", "Rotate 90° right"); clicked => { root.action("rot-right"); } }
                                    IBtn { icon: @image-url("icons/rot-180.svg"); tip: T.t("旋轉 180°", "Rotate 180°"); clicked => { root.action("rot-180"); } }
                                    IBtn { icon: @image-url("icons/flip-h.svg"); tip: T.t("水平翻轉", "Flip horizontal"); clicked => { root.action("flip-h"); } }
                                    IBtn { icon: @image-url("icons/flip-v.svg"); tip: T.t("垂直翻轉", "Flip vertical"); clicked => { root.action("flip-v"); } }
                                }
                                Section { text: T.t("選取 / 裁切", "Select / crop"); }
                                CheckBox { text: T.t("圓形選取", "Circular selection"); checked <=> root.select-circle; }
                                HorizontalLayout {
                                    spacing: 3px;
                                    alignment: start;
                                    IBtn { icon: @image-url("icons/select-all.svg"); tip: T.t("全選 (Ctrl+A)", "Select all (Ctrl+A)"); clicked => { root.action("select-all"); } }
                                    IBtn { icon: @image-url("icons/deselect.svg"); tip: T.t("取消選取 (Ctrl+D)", "Deselect (Ctrl+D)"); enabled: root.has-selection; clicked => { root.action("deselect"); } }
                                    IBtn { icon: @image-url("icons/crop.svg"); tip: T.t("裁切到選取區 (Enter)", "Crop to selection (Enter)"); enabled: root.has-selection; clicked => { root.action("crop"); } }
                                }
                                Section { text: T.t("尺寸", "Size"); }
                                HorizontalLayout {
                                    spacing: 4px;
                                    SpinBox { minimum: 1; maximum: 16000; value <=> root.rs-w; edited => { root.action("rs-w"); } }
                                    Text { text: "×"; vertical-alignment: center; }
                                    SpinBox { minimum: 1; maximum: 16000; value <=> root.rs-h; edited => { root.action("rs-h"); } }
                                }
                                CheckBox { text: T.t("維持比例", "Keep aspect ratio"); checked <=> root.rs-keep; }
                                HorizontalLayout {
                                    spacing: 3px;
                                    alignment: start;
                                    IBtn { icon: @image-url("icons/resize.svg"); tip: T.t("縮放影像到上方尺寸", "Resize image to the size above"); clicked => { root.action("resize"); } }
                                    IBtn { icon: @image-url("icons/canvas-size.svg"); tip: T.t("畫布大小改為上方尺寸", "Set canvas to the size above"); clicked => { root.action("canvas-size"); } }
                                }
                                Section { text: T.t("調整（有選取時只套用選取區）", "Adjustments (selection only if any)"); }
                                LabeledSlider { label: T.t("亮度", "Brightness"); minimum: -100; maximum: 100; value <=> root.a-bright; apply => { root.action("f-bright"); } }
                                LabeledSlider { label: T.t("對比", "Contrast"); minimum: -100; maximum: 100; value <=> root.a-contrast; apply => { root.action("f-contrast"); } }
                                LabeledSlider { label: T.t("飽和度", "Saturation"); minimum: -100; maximum: 100; value <=> root.a-sat; apply => { root.action("f-sat"); } }
                                LabeledSlider { label: T.t("曝光", "Exposure"); minimum: -3; maximum: 3; decimals: 1; value <=> root.a-expo; apply => { root.action("f-expo"); } }
                                LabeledSlider { label: T.t("色相", "Hue"); minimum: -180; maximum: 180; value <=> root.a-hue; apply => { root.action("f-hue"); } }
                                LabeledSlider { label: T.t("色溫", "Temperature"); minimum: -100; maximum: 100; value <=> root.a-temp; apply => { root.action("f-temp"); } }
                                LabeledSlider { label: T.t("色調", "Tint"); minimum: -100; maximum: 100; value <=> root.a-tint; apply => { root.action("f-tint"); } }
                                LabeledSlider { label: T.t("模糊", "Blur"); minimum: 0.1; maximum: 20; decimals: 1; value <=> root.a-blur; apply => { root.action("f-blur"); } }
                                LabeledSlider { label: T.t("銳利化", "Sharpen"); minimum: 0.1; maximum: 10; decimals: 1; value <=> root.a-sharp; apply => { root.action("f-sharp"); } }
                                LabeledSlider { label: T.t("懷舊", "Sepia"); minimum: 0; maximum: 1; decimals: 1; value <=> root.a-sepia; apply => { root.action("f-sepia"); } }
                                LabeledSlider { label: T.t("暗角", "Vignette"); minimum: 0; maximum: 1; decimals: 1; value <=> root.a-vig; apply => { root.action("f-vig"); } }
                                LabeledSlider { label: T.t("色階", "Posterize"); minimum: 2; maximum: 16; value <=> root.a-post; apply => { root.action("f-post"); } }
                                HorizontalLayout {
                                    spacing: 3px;
                                    alignment: start;
                                    IBtn { icon: @image-url("icons/grayscale.svg"); tip: T.t("灰階", "Grayscale"); clicked => { root.action("f-gray"); } }
                                    IBtn { icon: @image-url("icons/invert.svg"); tip: T.t("負片", "Invert colours"); clicked => { root.action("f-invert"); } }
                                    IBtn { icon: @image-url("icons/auto-contrast.svg"); tip: T.t("自動對比", "Auto contrast"); clicked => { root.action("f-auto"); } }
                                }
                                IBtn { icon: @image-url("icons/reset.svg"); tip: T.t("還原成原始影像", "Reset to original"); clicked => { root.action("reset"); } }
                            }
                            // ===== Stickers
                            if root.tab == 3: VerticalLayout {
                                spacing: 6px;
                                LineEdit { placeholder-text: T.t("搜尋：愛心、arrow、NEW…", "Search: heart, 箭頭, NEW…"); text <=> root.sticker-query; edited => { root.sticker-search(); } }
                                ComboBox { model: root.sticker-categories; current-index <=> root.sticker-category; selected => { root.sticker-search(); } }
                                Text { text: T.t("點一下插入到中央，或拖曳到畫布上。", "Click to insert at centre, or drag onto the canvas."); font-size: 11px; color: #666; wrap: word-wrap; }
                                Rectangle {
                                    height: ceil(root.stickers.length / 5) * 62px;
                                    for s[i] in root.stickers: Rectangle {
                                        x: mod(i, 5) * 62px;
                                        y: floor(i / 5) * 62px;
                                        width: 58px; height: 58px;
                                        border-radius: 6px;
                                        background: sta.has-hover ? #e3ecfd : #f4f6f9;
                                        Image { source: s.img; width: 48px; height: 48px; }
                                        sta := TouchArea {
                                            property <bool> moved-far;
                                            pointer-event(e) => {
                                                if (e.kind == PointerEventKind.down) { self.moved-far = false; }
                                                if (e.kind == PointerEventKind.up) {
                                                    if (root.dragging-sticker) {
                                                        root.dragging-sticker = false;
                                                        if (root.drag-x >= canvas-area.absolute-position.x - root.absolute-position.x && root.drag-x < canvas-area.absolute-position.x - root.absolute-position.x + canvas-area.width
                                                            && root.drag-y >= canvas-area.absolute-position.y - root.absolute-position.y && root.drag-y < canvas-area.absolute-position.y - root.absolute-position.y + canvas-area.height) {
                                                            root.sticker-drop(s.id, root.drag-x - (canvas-area.absolute-position.x - root.absolute-position.x), root.drag-y - (canvas-area.absolute-position.y - root.absolute-position.y));
                                                        }
                                                    } else if (!self.moved-far) {
                                                        root.sticker-click(s.id);
                                                    }
                                                }
                                            }
                                            moved => {
                                                if (abs(self.mouse-x - self.pressed-x) + abs(self.mouse-y - self.pressed-y) > 8px) {
                                                    self.moved-far = true;
                                                    root.dragging-sticker = true;
                                                    root.drag-img = s.img;
                                                    root.drag-id = s.id;
                                                    root.drag-x = self.absolute-position.x - root.absolute-position.x + self.mouse-x;
                                                    root.drag-y = self.absolute-position.y - root.absolute-position.y + self.mouse-y;
                                                }
                                            }
                                        }
                                    }
                                }
                                Section { text: T.t("貼圖樣式（新貼圖與選取的貼圖）", "Sticker style (new + selected)"); }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Rectangle { width: 24px; height: 24px; background: root.st-fill; border-width: 1px; border-color: #888; }
                                    IBtn { icon: @image-url("icons/fill-color.svg"); tip: T.t("貼圖填色 = 色 1", "Sticker fill = colour 1"); clicked => { root.action("st-fill"); } }
                                    Rectangle { width: 24px; height: 24px; background: root.st-outline; border-width: 1px; border-color: #888; }
                                    IBtn { icon: @image-url("icons/outline-color.svg"); tip: T.t("貼圖外框 = 色 2", "Sticker outline = colour 2"); clicked => { root.action("st-outline"); } }
                                }
                                LabeledSlider { label: T.t("外框粗細", "Outline"); minimum: 0; maximum: 12; value <=> root.st-stroke; has-apply: false; changed value => { root.action("st-style"); } }
                                CheckBox { text: T.t("陰影", "Shadow"); checked <=> root.st-shadow; toggled => { root.action("st-style"); } }
                            }
                            // ===== Redact
                            if root.tab == 4: VerticalLayout {
                                spacing: 6px;
                                Section { text: T.t("自動打碼（離線文字偵測）", "Auto redact (offline text detection)"); }
                                Button { text: root.detecting ? T.t("偵測中…", "Detecting…") : T.t("偵測文字", "Detect text"); enabled: !root.detecting; primary: true; clicked => { root.action("detect"); } }
                                Text { text: root.redact-info; wrap: word-wrap; font-size: 11px; color: #444; }
                                HorizontalLayout {
                                    spacing: 3px;
                                    alignment: start;
                                    IBtn { icon: @image-url("icons/tool-redact-box.svg"); tip: T.t("打碼框工具 (R)", "Redact box tool (R)"); active: root.tool == 14; clicked => { root.action("tool-redact-box"); } }
                                    IBtn { icon: @image-url("icons/tool-redact-brush.svg"); tip: T.t("打碼筆刷 (Shift+R)", "Redact brush (Shift+R)"); active: root.tool == 15; clicked => { root.action("tool-redact-brush"); } }
                                }
                                Text { text: T.t("框選：拖曳新增、點擊切換、右鍵刪除。", "Boxes: drag to add, click to toggle, right-click to delete."); font-size: 11px; color: #666; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 3px;
                                    alignment: start;
                                    IBtn { icon: @image-url("icons/sel-sensitive.svg"); tip: T.t("只選敏感資料（電話、Email、身分證…）", "Select sensitive items only (phone, email, ID…)"); clicked => { root.action("sel-sensitive"); } }
                                    IBtn { icon: @image-url("icons/sel-all-boxes.svg"); tip: T.t("全選打碼框", "Select all boxes"); clicked => { root.action("sel-all-boxes"); } }
                                    IBtn { icon: @image-url("icons/sel-no-boxes.svg"); tip: T.t("全部不選", "Select no boxes"); clicked => { root.action("sel-no-boxes"); } }
                                    IBtn { icon: @image-url("icons/clear-boxes.svg"); tip: T.t("清除所有打碼框", "Clear all boxes"); clicked => { root.action("clear-boxes"); } }
                                }
                                HorizontalLayout {
                                    spacing: 3px;
                                    LineEdit { placeholder-text: T.t("關鍵字", "Keyword"); text <=> root.redact-keyword; }
                                    IBtn { icon: @image-url("icons/keyword.svg"); tip: T.t("選取含關鍵字的框", "Select boxes containing the keyword"); clicked => { root.action("sel-keyword"); } }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    Text { text: T.t("樣式", "Style"); vertical-alignment: center; width: 78px; }
                                    ComboBox { model: [T.t("實心色塊（最安全）", "Solid box (safest)"), T.t("馬賽克", "Mosaic"), T.t("高斯模糊", "Gaussian blur")]; current-index <=> root.redact-style; }
                                }
                                LabeledSlider { label: T.t("外擴", "Padding"); minimum: 0; maximum: 40; value <=> root.redact-padding; has-apply: false; }
                                if root.redact-style == 1: LabeledSlider { label: T.t("格大小", "Block"); minimum: 4; maximum: 48; value <=> root.mosaic-block; has-apply: false; }
                                if root.redact-style == 2: LabeledSlider { label: "Sigma"; minimum: 2; maximum: 40; value <=> root.blur-sigma; has-apply: false; }
                                LabeledSlider { label: T.t("筆刷半徑", "Brush radius"); minimum: 2; maximum: 80; value <=> root.redact-radius; has-apply: false; }
                                Text { text: T.t("實心色塊與筆刷使用色 1。", "Solid box and brush use colour 1."); font-size: 11px; color: #666; }
                                CheckBox { text: T.t("匯出時保留中繼資料（預設移除）", "Keep metadata on export (stripped by default)"); checked <=> root.keep-metadata; }
                                Button { text: T.t("套用打碼（破壞性）", "Apply redaction (destructive)"); primary: true; clicked => { root.action("apply-redact"); } }
                                for b[i] in root.box-list: HorizontalLayout {
                                    spacing: 4px;
                                    CheckBox { checked: b.selected; toggled => { root.toggle-box(i); } }
                                    Text { text: b.label; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                }
                            }
                            // ===== Info / C2PA
                            if root.tab == 5: VerticalLayout {
                                spacing: 6px;
                                Section { text: T.t("影像資訊", "Image info"); }
                                Text { text: root.info-text; wrap: word-wrap; }
                                Section { text: T.t("C2PA 內容憑證", "C2PA content credentials"); }
                                Text { text: root.c2pa-text; wrap: word-wrap; font-size: 11px; }
                                CheckBox { text: T.t("儲存時寫入 C2PA", "Write C2PA on save"); checked <=> root.c2pa-on-save; }
                                IBtn { icon: @image-url("icons/c2pa.svg"); tip: T.t("C2PA 內容憑證…", "C2PA content credentials…"); clicked => { root.c2pa-open = true; root.action("refresh-info"); } }
                            }
                            // ===== Batch
                            if root.tab == 6: VerticalLayout {
                                spacing: 6px;
                                Section { text: T.t("批次轉檔 / 縮圖 / 浮水印", "Batch convert / resize / watermark"); }
                                HorizontalLayout { spacing: 3px; LineEdit { text <=> root.batch-in; placeholder-text: T.t("來源資料夾", "Input folder"); } IBtn { icon: @image-url("icons/folder.svg"); tip: T.t("選擇來源資料夾…", "Choose input folder…"); clicked => { root.action("batch-in"); } } }
                                HorizontalLayout { spacing: 3px; LineEdit { text <=> root.batch-out; placeholder-text: T.t("輸出資料夾", "Output folder"); } IBtn { icon: @image-url("icons/folder.svg"); tip: T.t("選擇輸出資料夾…", "Choose output folder…"); clicked => { root.action("batch-out"); } } }
                                ComboBox { model: root.format-names; current-index <=> root.batch-format; }
                                HorizontalLayout {
                                    spacing: 4px;
                                    Text { text: T.t("最大寬高(0=不限)", "Max W×H (0=any)"); vertical-alignment: center; }
                                    SpinBox { minimum: 0; maximum: 16000; value <=> root.batch-max-w; }
                                    SpinBox { minimum: 0; maximum: 16000; value <=> root.batch-max-h; }
                                }
                                LineEdit { text <=> root.batch-watermark; placeholder-text: T.t("浮水印文字（可留空）", "Watermark text (optional)"); }
                                HorizontalLayout {
                                    spacing: 3px;
                                    alignment: start;
                                    IBtn { icon: @image-url("icons/batch-run.svg"); tip: T.t("執行批次", "Run batch"); enabled: !root.batch-running; clicked => { root.action("batch-run"); } }
                                    IBtn { icon: @image-url("icons/c2pa.svg"); tip: T.t("C2PA 批次…", "C2PA batch…"); clicked => { root.c2pa-open = true; root.action("refresh-info"); } }
                                }
                                Text { text: root.batch-progress; wrap: word-wrap; font-size: 11px; }
                                Section { text: T.t("GIF 動畫", "Animated GIF"); }
                                HorizontalLayout { spacing: 3px; IBtn { icon: @image-url("icons/pick-frames.svg"); tip: T.t("選擇影格…", "Pick frames…"); clicked => { root.action("gif-pick"); } } Text { text: root.gif-frames; vertical-alignment: center; } }
                                LabeledSlider { label: T.t("間隔 ms", "Delay ms"); minimum: 20; maximum: 3000; value <=> root.gif-delay; has-apply: false; }
                                HorizontalLayout {
                                    spacing: 4px;
                                    CheckBox { text: T.t("循環", "Loop"); checked <=> root.gif-repeat; }
                                    Text { text: T.t("最大邊", "Max side"); vertical-alignment: center; }
                                    SpinBox { minimum: 0; maximum: 4000; value <=> root.gif-max; }
                                }
                                IBtn { icon: @image-url("icons/gif.svg"); tip: T.t("建立 GIF…", "Create GIF…"); clicked => { root.action("gif-run"); } }
                                Section { text: T.t("360° 全景 JPEG（目前影像）", "360° panorama JPEG (current image)"); }
                                HorizontalLayout {
                                    spacing: 4px;
                                    ComboBox { model: [T.t("補邊", "Pad"), T.t("拉伸", "Stretch"), T.t("裁切", "Crop")]; current-index <=> root.pano-mode; }
                                    SpinBox { minimum: 0; maximum: 30000; value <=> root.pano-width; }
                                }
                                IBtn { icon: @image-url("icons/panorama.svg"); tip: T.t("輸出 360° 全景 JPEG…", "Export 360° panorama JPEG…"); clicked => { root.action("pano-run"); } }
                            }
                            // ===== Settings
                            if root.tab == 7: VerticalLayout {
                                spacing: 6px;
                                Section { text: T.t("語言", "Language"); }
                                ComboBox { model: ["繁體中文", "English"]; current-index <=> root.language; selected => { root.language-changed(root.language); } }
                                Section { text: T.t("右鍵選單與開啟方式", "Right-click menu & Open With"); }
                                Text { text: root.shell-state; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 3px;
                                    alignment: start;
                                    IBtn { icon: @image-url("icons/shell.svg"); tip: T.t("註冊右鍵選單與開啟方式", "Register right-click menu & Open With"); clicked => { root.action("shell-register"); } }
                                    IBtn { icon: @image-url("icons/unregister.svg"); tip: T.t("移除右鍵選單登錄", "Remove right-click menu registration"); clicked => { root.action("shell-unregister"); } }
                                }
                                Section { text: T.t("關於", "About"); }
                                Text { text: "Pixel Studio " + root.version + "\n" + T.t("Rust + Slint，MIT 授權。", "Rust + Slint, MIT licensed."); wrap: word-wrap; }
                                Button { text: T.t("鍵盤快捷鍵…", "Keyboard shortcuts…"); clicked => { root.keys-open = true; } }
                            }
                        }
                    }
                }
            }
        }
        // ------------------------------------------------------------ status bar
        if root.show-status: Rectangle {
            height: 24px;
            background: #dfe4ea;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px;
                spacing: 16px;
                Text { text: root.status; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                Text { text: root.cursor-info; vertical-alignment: center; }
                Text { text: root.doc-info; vertical-alignment: center; }
            }
        }
    }
    }
    // ---------------- menu bar (overlay so drop-downs draw above the canvas and panels)
    Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: root.menu-open >= 0 ? root.height : 26px;
        if root.menu-open >= 0: TouchArea { clicked => { root.menu-open = -1; root.recent-open = false; } }
        Rectangle {
            x: 0; y: 0; width: parent.width; height: 26px;
            background: #ffffff;
            Rectangle { y: parent.height - 1px; height: 1px; background: #e2e6eb; }
            HorizontalLayout {
                padding-left: 4px;
                alignment: start;
                for mt[mi] in root.menu-titles: Rectangle {
                    width: mtl.preferred-width + 16px;
                    background: root.menu-open == mi ? #dbe6fb : (mta.has-hover ? #eef2f8 : transparent);
                    accessible-role: button;
                    accessible-label: T.t(mt.zh, mt.key + mt.en-rest);
                    accessible-action-default => { root.open-menu(mi); }
                    mta := TouchArea {
                        clicked => { if (root.menu-open == mi) { root.menu-open = -1; } else { root.open-menu(mi); } }
                        changed has-hover => { if (self.has-hover && root.menu-open >= 0 && root.menu-open != mi) { root.open-menu(mi); } }
                    }
                    mtl := HorizontalLayout {
                        x: 8px;
                        width: self.preferred-width;
                        spacing: 0px;
                        alignment: start;
                        Text { text: T.zh ? mt.zh + "(" : ""; vertical-alignment: center; color: #1d2a3a; }
                        Rectangle {
                            width: mk.preferred-width;
                            mk := Text { text: mt.key; vertical-alignment: center; color: #1d2a3a; }
                            Rectangle { x: 0; y: parent.height / 2 + 7px; width: parent.width; height: 1px; background: #1d2a3a; }
                        }
                        Text { text: T.zh ? ")" : mt.en-rest; vertical-alignment: center; color: #1d2a3a; }
                    }
                    if root.menu-open == mi: Rectangle {
                        x: 0; y: 26px;
                        width: 272px;
                        height: mdl.preferred-height;
                        background: white;
                        border-width: 1px;
                        border-color: #cfd6df;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #0004;
                        TouchArea { }
                        mdl := VerticalLayout {
                            padding-top: 4px; padding-bottom: 4px;
                            for m[k] in root.cur-items: Rectangle {
                                height: m.sep ? 9px : 26px;
                                if m.sep: Rectangle { y: 4px; height: 1px; x: 8px; width: parent.width - 16px; background: #e4e8ee; }
                                if !m.sep: MenuRow {
                                    width: parent.width;
                                    label: m.label;
                                    shortcut: m.act == "recent-menu" ? "" : m.key;
                                    icon: m.icon;
                                    enabled: m.enabled;
                                    check: m.check;
                                    checked: m.checked;
                                    highlighted: root.menu-hl == k || (m.act == "recent-menu" && root.recent-open);
                                    hovered => { root.menu-hl = k; if (m.act == "recent-menu" && m.enabled) { root.recent-open = true; } else { root.recent-open = false; } }
                                    clicked => { root.run-item(m); }
                                }
                                if m.act == "recent-menu": Image { x: parent.width - 22px; y: 6px; width: 14px; height: 14px; source: @image-url("icons/next.svg"); colorize: m.enabled ? #6b7785 : #c3c8ce; }
                            }
                        }
                        if root.menu-open == 0 && root.recent-open: Rectangle {
                            x: parent.width - 4px;
                            y: 4px + 4 * 26px;
                            width: 380px;
                            height: rl.preferred-height;
                            background: white;
                            border-width: 1px;
                            border-color: #cfd6df;
                            drop-shadow-blur: 10px;
                            drop-shadow-color: #0004;
                            rl := VerticalLayout {
                                padding-top: 4px; padding-bottom: 4px;
                                for r[ri] in root.recent-files: MenuRow {
                                    label: (ri + 1) + "  " + r;
                                    icon: @image-url("icons/layer-image.svg");
                                    clicked => { root.menu-open = -1; root.recent-open = false; root.action("recent:" + ri); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // ---------------- quick-save prompt (first quick save of a document)
    if root.qs-open: Rectangle {
        background: #0006;
        TouchArea { }
        Rectangle {
            width: 380px;
            height: qsl.preferred-height;
            background: white;
            border-radius: 8px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #0006;
            qsl := VerticalLayout {
                padding: 16px;
                spacing: 10px;
                Section { text: T.t("快速儲存設定", "Quick save settings"); }
                Text { text: T.t("只會在第一次快速儲存時詢問；之後 Ctrl+S 直接覆寫。", "Asked only on the first quick save; after that Ctrl+S overwrites directly."); wrap: word-wrap; font-size: 11px; color: #555; }
                Text { text: root.qs-target; wrap: word-wrap; font-size: 11px; }
                HorizontalLayout { spacing: 6px; Text { text: T.t("格式", "Format"); width: 78px; vertical-alignment: center; } ComboBox { model: root.format-names; current-index <=> root.export-format; } }
                LabeledSlider { label: T.t("品質", "Quality"); minimum: 1; maximum: 100; value <=> root.quality; has-apply: false; }
                CheckBox { text: T.t("WebP 無損", "WebP lossless"); checked <=> root.webp-lossless; }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;
                    Button { text: T.t("取消", "Cancel"); clicked => { root.qs-open = false; } }
                    Button { text: T.t("儲存", "Save"); primary: true; clicked => { root.qs-open = false; root.action("quick-save-confirm"); } }
                }
            }
        }
    }
    // ---------------- C2PA dialog
    if root.c2pa-open: Rectangle {
        background: #0006;
        TouchArea { }
        Rectangle {
            width: min(620px, root.width - 40px);
            height: min(c2l.preferred-height, root.height - 40px);
            background: white;
            border-radius: 8px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #0006;
            ScrollView {
                c2l := VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    HorizontalLayout {
                        Section { text: T.t("C2PA 內容憑證", "C2PA content credentials"); font-size: 16px; horizontal-stretch: 1; }
                        Button { text: T.t("關閉", "Close"); clicked => { root.c2pa-open = false; } }
                    }
                    Rectangle {
                        background: root.c2pa-present ? #e8f5e9 : #f4f6f9;
                        border-radius: 6px;
                        height: c2t.preferred-height + 16px;
                        c2t := Text { x: 8px; width: parent.width - 16px; text: root.c2pa-text; wrap: word-wrap; }
                    }
                    if root.c2pa-raw != "": VerticalLayout {
                        spacing: 4px;
                        Text { text: T.t("原始 manifest JSON", "Raw manifest JSON"); font-size: 11px; color: #555; }
                        TextEdit { height: 140px; read-only: true; font-size: 10px; text: root.c2pa-raw; }
                    }
                    Section { text: T.t("單張：加入／移除", "Single image: add / remove"); }
                    GridLayout {
                        spacing: 6px;
                        Row { Text { text: T.t("標題", "Title"); vertical-alignment: center; } LineEdit { text <=> root.c2pa-title; } }
                        Row { Text { text: T.t("作者", "Creator"); vertical-alignment: center; } LineEdit { text <=> root.c2pa-creator; } }
                        Row { Text { text: T.t("動作說明", "Action note"); vertical-alignment: center; } TextEdit { height: 56px; text <=> root.c2pa-action; } }
                    }
                    CheckBox { text: T.t("儲存時寫入 C2PA（使用上方資料）", "Write C2PA on save (using the fields above)"); checked <=> root.c2pa-on-save; }
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: T.t("加入 C2PA 並另存目前影像…", "Add C2PA & save current image as…"); primary: true; clicked => { root.action("c2pa-write"); } }
                        Button { text: T.t("移除 C2PA 另存…", "Strip C2PA to a copy…"); enabled: root.has-source; clicked => { root.action("c2pa-remove"); } }
                    }
                    Text { text: T.t("移除 C2PA 會複製來源檔並只拿掉 manifest（副檔名與來源相同，不能覆寫來源）。", "Stripping copies the source file bytes and removes only the manifest (same extension, cannot overwrite the source)."); wrap: word-wrap; font-size: 11px; color: #666; }
                    Section { text: T.t("批次 C2PA", "Batch C2PA"); }
                    HorizontalLayout { spacing: 3px; LineEdit { text <=> root.c2pa-in; placeholder-text: T.t("來源資料夾", "Input folder"); } IBtn { icon: @image-url("icons/folder.svg"); tip: T.t("選擇來源資料夾…", "Choose input folder…"); clicked => { root.action("c2pa-in"); } } }
                    HorizontalLayout { spacing: 3px; LineEdit { text <=> root.c2pa-out; placeholder-text: T.t("輸出資料夾", "Output folder"); } IBtn { icon: @image-url("icons/folder.svg"); tip: T.t("選擇輸出資料夾…", "Choose output folder…"); clicked => { root.action("c2pa-out"); } } }
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: T.t("批次加入（使用上方資料）", "Batch add (fields above)"); enabled: !root.batch-running && root.c2pa-in != "" && root.c2pa-out != ""; clicked => { root.action("batch-c2pa-add"); } }
                        Button { text: T.t("批次移除", "Batch remove"); enabled: !root.batch-running && root.c2pa-in != "" && root.c2pa-out != ""; clicked => { root.action("batch-c2pa-remove"); } }
                    }
                    Text { text: root.c2pa-batch-text; wrap: word-wrap; font-size: 11px; }
                }
            }
        }
    }
    if root.dragging-sticker: Image {
        x: root.drag-x - 28px; y: root.drag-y - 28px;
        width: 56px; height: 56px;
        source: root.drag-img;
        opacity: 0.8;
    }
    // ---------------- resize / canvas size
    if root.rs-open: Dialog {
        title: T.t("影像大小 / 畫布大小", "Image size / canvas size");
        close => { root.rs-open = false; }
        HorizontalLayout {
            spacing: 6px;
            Text { text: T.t("寬 × 高 (px)", "W × H (px)"); vertical-alignment: center; width: 90px; }
            SpinBox { minimum: 1; maximum: 16000; value <=> root.rs-w; edited => { root.action("rs-w"); } }
            Text { text: "×"; vertical-alignment: center; }
            SpinBox { minimum: 1; maximum: 16000; value <=> root.rs-h; edited => { root.action("rs-h"); } }
        }
        CheckBox { text: T.t("維持比例", "Keep aspect ratio"); checked <=> root.rs-keep; }
        Text { text: T.t("縮放影像會重新取樣像素；畫布大小只增減邊界（新區域用色 2 填滿）。", "Resize resamples the pixels; canvas size only adds/removes border (new area uses colour 2)."); wrap: word-wrap; font-size: 11px; color: #555; }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            Button { text: T.t("取消", "Cancel"); clicked => { root.rs-open = false; } }
            Button { text: T.t("畫布大小", "Canvas size"); clicked => { root.rs-open = false; root.action("canvas-size"); } }
            Button { text: T.t("縮放影像", "Resize image"); primary: true; clicked => { root.rs-open = false; root.action("resize"); } }
        }
    }
    // ---------------- properties
    if root.props-open: Dialog {
        title: T.t("影像內容", "Image properties");
        card-width: 520px;
        close => { root.props-open = false; }
        Text { text: root.props-text; wrap: word-wrap; }
        HorizontalLayout { alignment: end; Button { text: T.t("關閉", "Close"); primary: true; clicked => { root.props-open = false; } } }
    }
    // ---------------- about
    if root.about-open: Dialog {
        title: T.t("關於 Pixel Studio", "About Pixel Studio");
        close => { root.about-open = false; }
        HorizontalLayout {
            spacing: 14px;
            Image { source: @image-url("../assets/icon-256.png"); width: 64px; height: 64px; }
            VerticalLayout {
                spacing: 4px;
                Text { text: "Pixel Studio 像素工作室 " + root.version; font-size: 15px; font-weight: 700; }
                Text { text: T.t("輕量影像編輯器：小畫家級繪圖、圖層、貼圖、自動打碼、C2PA 內容憑證、批次處理。", "Lightweight image editor: Paint-style drawing, layers, stickers, auto redaction, C2PA credentials, batch tools."); wrap: word-wrap; }
                Text { text: T.t("Rust + Slint，MIT 授權。圖示為本專案原創 SVG。", "Rust + Slint, MIT licensed. Icons are original SVGs made for this project."); wrap: word-wrap; font-size: 11px; color: #555; }
                Text { text: "github.com/stevenke1981/pixel-studio"; font-size: 11px; color: #2f6fed; }
            }
        }
        HorizontalLayout { alignment: end; Button { text: T.t("確定", "OK"); primary: true; clicked => { root.about-open = false; } } }
    }
    // ---------------- keyboard shortcuts
    if root.keys-open: Dialog {
        title: T.t("鍵盤快捷鍵", "Keyboard shortcuts");
        card-width: 640px;
        close => { root.keys-open = false; }
        ScrollView {
            min-height: 420px;
            VerticalLayout {
                spacing: 5px;
                Text { text: T.t("檔案 / 編輯", "File / edit"); font-weight: 700; color: #1f3b63; }
                KeyRow { keys: "Ctrl+N / Ctrl+O"; what: T.t("新增 / 開啟", "New / open"); }
                KeyRow { keys: "Ctrl+S / Ctrl+Shift+S"; what: T.t("快速儲存 / 另存新檔", "Quick save / save as"); }
                KeyRow { keys: "Ctrl+E / Ctrl+P"; what: T.t("匯出 / 列印", "Export / print"); }
                KeyRow { keys: "Alt+Enter / Alt+F4"; what: T.t("內容 / 結束", "Properties / exit"); }
                KeyRow { keys: "Ctrl+Z / Ctrl+Y"; what: T.t("復原 / 重做（Ctrl+Shift+Z 也可重做）", "Undo / redo (Ctrl+Shift+Z also redoes)"); }
                KeyRow { keys: "Ctrl+X / Ctrl+C"; what: T.t("剪下 / 複製", "Cut / copy"); }
                KeyRow { keys: "Ctrl+V / Ctrl+Shift+V"; what: T.t("貼上為新影像 / 貼上為圖層", "Paste as new image / paste as layer"); }
                KeyRow { keys: "Ctrl+A / Ctrl+D / Del"; what: T.t("全選 / 取消選取 / 刪除（圖層或選取區）", "Select all / deselect / delete (layer or selection)"); }
                Text { text: T.t("檢視 / 影像 / 圖層", "View / image / layer"); font-weight: 700; color: #1f3b63; }
                KeyRow { keys: "+ / - / 0 / 1"; what: T.t("放大 / 縮小 / 符合視窗 / 100%（也可加 Ctrl）", "Zoom in / out / fit / 100% (Ctrl optional)"); }
                KeyRow { keys: "Ctrl+G / Ctrl+R / F11"; what: T.t("像素格線 / 尺規 / 全螢幕", "Pixel grid / rulers / full screen"); }
                KeyRow { keys: "Ctrl+W / Ctrl+Shift+W"; what: T.t("影像大小 / 畫布大小", "Image size / canvas size"); }
                KeyRow { keys: "Enter / Esc"; what: T.t("裁切到選取區 / 取消選取或關閉對話框", "Crop to selection / clear selection or close dialog"); }
                KeyRow { keys: "Ctrl+J / Ctrl+] / Ctrl+["; what: T.t("複製圖層 / 上移 / 下移", "Duplicate layer / bring forward / send backward"); }
                KeyRow { keys: "Ctrl+Shift+E"; what: T.t("合併所有圖層", "Merge all layers"); }
                KeyRow { keys: T.t("方向鍵", "Arrows"); what: T.t("移動圖層（Shift 一次 10px）；無圖層時切換上一張/下一張", "Nudge layer (Shift = 10px); with no layer, previous/next image"); }
                Text { text: T.t("工具", "Tools"); font-weight: 700; color: #1f3b63; }
                KeyRow { keys: "S P B L A K"; what: T.t("選取、鉛筆、筆刷、螢光筆、噴槍、書法筆", "Select, pencil, brush, highlighter, airbrush, calligraphy"); }
                KeyRow { keys: "E F I T M"; what: T.t("橡皮擦、油漆桶、滴管、文字、馬賽克筆", "Eraser, fill, picker, text, mosaic"); }
                KeyRow { keys: "C H U R Shift+R"; what: T.t("裁切、平移、形狀、打碼框、打碼筆刷", "Crop, pan, shapes, redact box, redact brush"); }
                KeyRow { keys: "X"; what: T.t("交換色 1 / 色 2", "Swap colour 1 / 2"); }
                KeyRow { keys: T.t("中鍵拖曳 / Ctrl+滾輪", "Middle-drag / Ctrl+wheel"); what: T.t("平移 / 縮放", "Pan / zoom"); }
                Text { text: T.t("選單", "Menus"); font-weight: 700; color: #1f3b63; }
                KeyRow { keys: "Alt+F E V I L T H"; what: T.t("開啟檔案、編輯、檢視、影像、圖層、工具、說明選單；方向鍵移動、Enter 執行、Esc 關閉", "Open File, Edit, View, Image, Layer, Tools, Help; arrows move, Enter runs, Esc closes"); }
                KeyRow { keys: "F1"; what: T.t("這個視窗", "This window"); }
            }
        }
    }
    // ---------------- shared tooltip (always on top)
    if Tip.text != "": Rectangle {
        x: max(4px, min(Tip.x, root.width - self.width - 4px));
        y: Tip.y + self.height + 4px > root.height ? Tip.y - self.height - 40px : Tip.y;
        width: tipt.preferred-width + 14px;
        height: 24px;
        border-radius: 4px;
        background: #263238f0;
        drop-shadow-blur: 4px;
        drop-shadow-color: #0004;
        tipt := Text { text: Tip.text; color: white; font-size: 12px; }
    }
}
